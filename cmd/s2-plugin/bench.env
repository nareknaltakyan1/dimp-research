# Benchmark integration for s2-plugin (Go plugins, built in-container with one
# toolchain/flag set like cmd/s2-plugin/build.sh).
#   E1-E4: v1 -> v2 (plugins/v2.so).
#   E5: 50 DISTINCT plugin generations v2.1 ... v2.50 (each a copy of the v2
#       source under its own import path - the only way to load a Go plugin
#       more than once, see build.sh). Alternating v2/v1 would only re-open the
#       already-loaded .so (plugin.Open is cached), which measures nothing.
#       Plugins can never be unloaded, so RSS growth per upgrade is expected.
#   E6: to=v2-broken - a well-formed plugin without the New symbol
#       (bench/fixtures/plugin-nonew): dlopen succeeds, symbol lookup fails,
#       upgrade_failed before publication.
: "${S2_GENS:=50}"
bench_build() {
  local o=$1 i src
  export CGO_ENABLED=1
  mkdir -p "$o/plugins"
  go build -o "$o/server" ./cmd/s2-plugin
  for v in v1 v2; do go build -buildmode=plugin -o "$o/plugins/$v.so" ./cmd/s2-plugin/plugins/$v; done
  go build -buildmode=plugin -o "$o/plugins/v2-broken.so" ./bench/fixtures/plugin-nonew
  if [[ "$EXP" == E5 ]]; then
    for ((i = 1; i <= S2_GENS; i++)); do
      src="bin/bench/_s2gen/v2gen$i"; mkdir -p "$src"
      sed "s/^var Version = \"v2\"/var Version = \"v2.$i\"/" cmd/s2-plugin/plugins/v2/main.go >"$src/main.go"
      go build -buildmode=plugin -o "$o/plugins/v2.$i.so" "./$src"
    done
  fi
}
if [[ "$EXP" == E5 ]]; then
  UPGRADE_TARGETS="$(for ((i = 1; i <= S2_GENS; i++)); do printf 'v2.%d ' "$i"; done)"
fi
FAIL_TARGET=v2-broken
