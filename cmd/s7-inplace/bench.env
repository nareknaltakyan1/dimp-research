# Benchmark integration for s7-inplace (signed WASM patches + in-process
# shadow -> canary 1% -> 10% -> 50% -> promote; contract /admin/upgrade uses
# canary.FastStrategy). Built with cmd/s7-inplace/build.sh (dev signing key).
#   E1-E4: v1 -> v2 (pre-staged signed bundle bundles/v2).
#   E5: versions must increase (downgrades are refused by policy), so E5 uses
#       50 distinct generations v2..v51: guest/v2 relinked with
#       -X main.Version=vN, each signed with base v(N-1). A rollout needs
#       samples in every stage, so at 100 req/s one upgrade takes
#       3-12 s (canary-1 needs 3 samples at 1% weight = ~1 req/s); E5 therefore
#       uses a 15 s trigger interval (S7_E5_INTERVAL_S) instead of 2 s.
#   E6: BENCH_VARIANT unset/buggy -> to=v3, the BUGGY guest (+4 ms latency;
#       wrong result only for x%10==3, which the loadgen never sends): it runs
#       in shadow, fails the latency SLO and is rolled back automatically.
#       BENCH_VARIANT=tampered -> to=v4, a signed manifest whose module was
#       substituted after signing: rejected by the digest check before load.
#   Admin auth: the harness binds the server to 127.0.0.1:$PORT and calls the
#       privileged POST /admin/upgrade there. s7-inplace allows tokenless
#       privileged endpoints ONLY on loopback-bound listeners (it refuses to
#       start otherwise); the separate admin listener (/admin/patch, ...) is
#       not used by the harness and is disabled to avoid a port clash.
#       Anti-rollback state is in memory (no -state-dir): each run starts at v1.
: "${S7_E5_GENS:=50}"
SERVER_ARGS="${SERVER_ARGS:+$SERVER_ARGS }-admin-addr=none"
bench_build() {
  local o=$1 n
  OUT="$o" cmd/s7-inplace/build.sh >/dev/null
  ln -sf s7-inplace "$o/server"
  local pc="$o/s7-patchctl" k="$o/dev-signing.key"
  "$pc" sign -key "$k" -module "$o/modules/v2.wasm" -version v4 -base v1 -out "$o/work-v4" >/dev/null
  "$pc" tamper -bundle "$o/work-v4" -module "$o/modules/v3.wasm" -out "$o/bundles/v4" >/dev/null
  if [[ "$EXP" == E5 ]]; then
    mkdir -p "$o/gen"
    for ((n = 2; n <= S7_E5_GENS + 1; n++)); do
      GOOS=wasip1 GOARCH=wasm go build -buildmode=c-shared -ldflags="-s -w -X main.Version=v$n" \
        -o "$o/gen/v$n.wasm" ./cmd/s7-inplace/guest/v2
      rm -rf "$o/bundles/v$n"
      "$pc" sign -key "$k" -module "$o/gen/v$n.wasm" -version "v$n" -base "v$((n - 1))" -out "$o/bundles/v$n" >/dev/null
    done
  fi
}
if [[ "$EXP" == E5 ]]; then
  UPGRADE_TARGETS="$(for ((n = 2; n <= S7_E5_GENS + 1; n++)); do printf 'v%d ' "$n"; done)"
  : "${UPGRADE_INTERVAL_S:=${S7_E5_INTERVAL_S:-15}}"
fi
if [[ "${BENCH_VARIANT:-}" == tampered ]]; then FAIL_TARGET=v4; else FAIL_TARGET=v3; fi
