# Benchmark integration for s6-hotpatch (hotpatch-ready compilation: signed Go
# plugin patch sets applied as one transaction). Built with cmd/s6-hotpatch/build.sh.
#   E1-E4: v1 -> v2 (plugins/v2.so + v2.manifest.json).
#   E5: TRIGGER=sighup - S6's SIGHUP toggles "apply v2" / "roll back the last
#       transaction" (v1 is the build-time base, not a loadable plugin, and
#       /admin/upgrade?to=v1 does not exist). Labels for the analysis: v2, v1, ...
#       Re-applying v2 re-uses the already loaded plugin (Go plugins cannot be
#       reloaded/unloaded), so this measures the transaction + quiescence
#       mechanism, not repeated code loading.
#   E6: to=badsig - v2.so signed by an untrusted key: rejected by signature
#       verification before dlopen, upgrade_failed, v1 keeps serving.
bench_build() {
  local o=$1
  OUT="$o" cmd/s6-hotpatch/build.sh >/dev/null
  ln -sf s6-hotpatch "$o/server"
}
if [[ "$EXP" == E5 ]]; then TRIGGER=sighup; fi
FAIL_TARGET=badsig
