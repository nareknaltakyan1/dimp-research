# Benchmark integration for s4-reuseport (process handoff, internal/handoff mode=reuseport).
# Every generation is a separately linked binary (-X main.version=...); the
# trigger selects it via ?bin=./server-<target> (needs -allow-bin-param).
#   E1-E4: v1 -> v2.  E5: v2, v1, v2, ... (each swap = new process from the other binary).
#   E6: BENCH_VARIANT unset/hang -> successor binary "v2-hang" never sends
#       "prepared" (simulateFail=hang): failing readiness, old aborts after
#       -ready-timeout=2s. BENCH_VARIANT=crash -> successor "v2-crash" exits
#       right after receiving the state (simulateFail=crash-after-state, the
#       post-seal rollback path).
# Not run with -supervise: in the harness the server is not PID 1 (the
# harness shell is) and procmon follows the whole session, so successors are
# measured either way.
bench_build() {
  local o=$1
  go build -o "$o/server" ./cmd/s4-reuseport
  for v in v1 v2; do go build -ldflags "-X main.version=$v" -o "$o/server-$v" ./cmd/s4-reuseport; done
  go build -ldflags "-X main.version=v2-hang -X main.simulateFail=hang" -o "$o/server-v2-hang" ./cmd/s4-reuseport
  go build -ldflags "-X main.version=v2-crash -X main.simulateFail=crash-after-state" -o "$o/server-v2-crash" ./cmd/s4-reuseport
}
# -idle-grace: idle keep-alive conns stay open this long during the drain (see internal/handoff/drain.go)
SERVER_ARGS="-allow-bin-param -ready-timeout=2s -idle-grace=1s"
UPGRADE_EXTRA_QUERY='bin=./server-%s'
if [[ "${BENCH_VARIANT:-}" == crash ]]; then FAIL_TARGET=v2-crash; else FAIL_TARGET=v2-hang; fi
