# Benchmark integration for s3-wasm (wazero, compiler mode, pool 8).
#   E1-E4: v1 -> v2.  E5: v2, v1, v2, ... - every upgrade re-reads and
#       re-compiles the module and unloads (Close) the drained one, so each swap
#       is a full load/unload cycle.
#   E6: to=v2-broken - a valid WASI module that does not export "handle"
#       (bench/fixtures/wasm-nohandle): rejected by wasmimpl.Load before publication.
bench_build() {
  local o=$1
  mkdir -p "$o/modules"
  go build -o "$o/server" ./cmd/s3-wasm
  for v in v1 v2; do GOOS=wasip1 GOARCH=wasm go build -buildmode=c-shared -o "$o/modules/$v.wasm" ./cmd/s3-wasm/guest/$v; done
  GOOS=wasip1 GOARCH=wasm go build -o "$o/modules/v2-broken.wasm" ./bench/fixtures/wasm-nohandle
}
FAIL_TARGET=v2-broken
