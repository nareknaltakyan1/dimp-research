# Benchmark integration for b0-naive-restart (sourced by scripts/run_experiment.sh).
# Upgrade = old process stops its listener (graceful Shutdown, drains in-flight),
# then spawns the NEW BINARY, which binds the port afterwards. State is lost
# (no -state-file): this is the stop/start baseline.
# Every generation is a separately linked binary (server-v1, server-v2 differ
# in -X main.version); the trigger selects it via ?bin=./server-<target>.
#   E1-E4: v1 -> v2.  E5: v2, v1, v2, ... (each swap execs the other binary).
#   E6: N/A in the sense of rollback - B0 has no rollback path. We still run it
#       with a successor binary that does not exist: the old process has already
#       closed its listener, spawn fails, it emits upgrade_failed and exits,
#       i.e. a failed upgrade = permanent outage (measured, not assumed).
bench_build() {
  local o=$1
  go build -o "$o/server" ./cmd/b0-naive-restart
  for v in v1 v2; do go build -ldflags "-X main.version=$v" -o "$o/server-$v" ./cmd/b0-naive-restart; done
}
SERVER_ARGS="-allow-bin-param"
UPGRADE_EXTRA_QUERY='bin=./server-%s'
FAIL_TARGET=v2-missing   # ./server-v2-missing does not exist
